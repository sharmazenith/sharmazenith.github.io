---
import "../styles/global.css"
import Intro from "../components/Intro.astro"
import { SITE, SPACE_NAME } from "../config"

interface Props {
  title?: string
  section: "home" | "space"
  crumbs?: { label: string; href: string }[]
  description?: string
}
const { title, section, crumbs = [], description = `${SITE.name}: résumé, shayari and notes.` } = Astro.props
const pageTitle = title ?? SITE.name
const trail = [{ label: SITE.name, href: "/" }, ...crumbs]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
  </head>
  <body>
    <header class="header">
      <div class="container">
        <nav class="crumbs" id="crumbs" aria-label="breadcrumb">
          {trail.map((c, i) => (
            <>
              {i > 0 && <span class="sep" aria-hidden="true">/</span>}
              <a href={c.href} class={i === trail.length - 1 && i > 1 ? "last" : undefined}>{c.label}</a>
            </>
          ))}
        </nav>
        <nav class="nav" id="nav" aria-label="main">
          <a href="/" data-section="home" aria-current={section === "home" ? "page" : undefined}>home</a>
          <a href="/kalam/" data-section="space" aria-current={section === "space" ? "page" : undefined}>{SPACE_NAME}</a>
          <button class="theme" id="theme" type="button" aria-label="switch theme">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <polygon class="half" points="15.5,0.5 15.5,15.5 0.5,15.5" />
              <rect x="0.5" y="0.5" width="15" height="15" />
            </svg>
          </button>
          <span class="bar" id="nav-bar" aria-hidden="true"></span>
        </nav>
      </div>
    </header>

    <div class="body">
      <div class="container">
        <main class="pane" id="pane" tabindex="-1" data-section={section}>
          <slot />
        </main>
        <Intro />
      </div>
    </div>

    <footer class="footer">
      <div class="container">
        <span>{SITE.name}, {SITE.year}</span>
        <nav aria-label="elsewhere">
          <a href={SITE.github} rel="noopener">github</a>
          {SITE.linkedin && <a href={SITE.linkedin} rel="noopener">linkedin</a>}
          {SITE.email && <a href={`mailto:${SITE.email}`}>email</a>}
        </nav>
        <span class="tnum" id="clock" data-tz={SITE.timezone}>my time</span>
      </div>
    </footer>

    <script>
      import "../scripts/frame.ts"
    </script>
  </body>
</html>
