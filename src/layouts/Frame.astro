---
import "../styles/global.css"
import Intro from "../components/Intro.astro"
import Signature from "../components/Signature.astro"
import { SITE, SPACE_NAME, CITY, NOW_PLAYING_ENDPOINT, NOW_PLAYING_MOCK } from "../config"

interface Props {
  title?: string
  section: "home" | "space"
  crumbs?: { label: string; href: string }[]
  description?: string
}
const { title, section, crumbs = [], description = `${SITE.name}: résumé, shayari and notes.` } = Astro.props
const pageTitle = title ?? SITE.name
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", t);
        try {
          if (!sessionStorage.getItem("sig") && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
            document.documentElement.classList.add("sig-draw");
            sessionStorage.setItem("sig", "1");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="header">
      <div class="container">
        <div class="brand">
          <Signature />
          <nav class="crumbs" id="crumbs" aria-label="breadcrumb">
            {crumbs.map((c, i) => (
              <>
                <span class="sep" aria-hidden="true">/</span>
                <a href={c.href} class={i === crumbs.length - 1 && i > 0 ? "last" : undefined}>{c.label}</a>
              </>
            ))}
          </nav>
        </div>
        <nav class="nav" id="nav" aria-label="main">
          <a href="/" data-section="home" aria-current={section === "home" ? "page" : undefined}>home</a>
          <a href="/kalam/" data-section="space" aria-current={section === "space" ? "page" : undefined}>{SPACE_NAME}</a>
          <button class="theme" id="theme" type="button" aria-label="switch theme">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <polygon class="half" points="15.5,0.5 15.5,15.5 0.5,15.5" />
              <rect x="0.5" y="0.5" width="15" height="15" />
            </svg>
          </button>
          <span class="bar" id="nav-bar" aria-hidden="true"></span>
        </nav>
      </div>
    </header>

    <div class="sr" id="announce" role="status" aria-live="polite"></div>

    <div class="body">
      <div class="container">
        <main class="pane" id="pane" data-section={section}>
          <slot />
        </main>
        <Intro />
      </div>
    </div>

    <footer class="footer"
      data-lat={CITY.lat} data-lon={CITY.lon} data-tz={CITY.tz}
      data-endpoint={NOW_PLAYING_ENDPOINT} data-mock={JSON.stringify(NOW_PLAYING_MOCK)}>
      <div class="container foot">
        <div class="where tnum" aria-label="where and when">
          <span>{CITY.name}</span>
          <i class="dot" id="dot-temp" hidden></i><span id="temp" hidden></span>
          <i class="dot"></i><span id="time"></span>
        </div>
        <div class="np" id="np" data-state="idle">
          <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="np-win"><span class="np-track" id="np-track">not playing</span></span>
        </div>
        <nav class="elsewhere" aria-label="elsewhere">
          <a href={SITE.github} rel="noopener">github</a>
          {SITE.linkedin && <a href={SITE.linkedin} rel="noopener">linkedin</a>}
          {SITE.email && <a href={`mailto:${SITE.email}`}>email</a>}
          <button id="sound" type="button" aria-pressed="true">sound on</button>
        </nav>
      </div>
    </footer>

    <script>
      import "../scripts/frame.ts"
    </script>
  </body>
</html>
