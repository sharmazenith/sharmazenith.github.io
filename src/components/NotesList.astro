---
import { fmtDay, type Note } from "../lib/content"
interface Props { items: Note[] }
const { items } = Astro.props
---
{items.length === 0 ? <p class="empty list-empty">Nothing here yet.</p> : (
  <div class="nlist">
    {items.map((e) => (
      <a class="nrow" href={`/kalam/notes/${e.id}/`}>
        <span class="d">{fmtDay(e.data.date)}</span>
        <span class="tx" lang={e.data.lang} dir={e.data.lang === "ur" ? "rtl" : undefined}>
          <span class="t">{e.data.title}</span>
          {e.data.excerpt && <span class="x">{e.data.excerpt}</span>}
        </span>
        <span class="arr">→</span>
      </a>
    ))}
  </div>
)}
