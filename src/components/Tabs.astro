---
import { SPACE_NAME } from "../config"
interface Props { active: "shayari" | "notes"; shayari: number; notes: number }
const { active, shayari, notes } = Astro.props
---
<div class="tabs" id="tabs" data-tabs>
  <span class="sort">newest first</span>
  <div class="tabset" role="navigation" aria-label={`${SPACE_NAME} sections`}>
    <a class="tab" href="/kalam/" aria-current={active === "shayari" ? "page" : undefined}>shayari<span>{shayari}</span></a>
    <a class="tab" href="/kalam/notes/" aria-current={active === "notes" ? "page" : undefined}>notes<span>{notes}</span></a>
    <span class="bar" id="tab-bar" aria-hidden="true"></span>
  </div>
</div>
