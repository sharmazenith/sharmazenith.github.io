---
// Drop the traced signature at src/assets/signature.svg (single filled path, no fill attribute needed)
// and it replaces the wordmark below. Until then a plain "zenith" wordmark stands in.
const found = import.meta.glob("../assets/signature.svg", { query: "?raw", import: "default", eager: true })
const svg = Object.values(found)[0] as string | undefined
---
<a class="logo" href="/" aria-label="Zenith Sharma, home">
  {svg
    ? <span class="logo-art" role="img" aria-label="zenith" set:html={svg} />
    : <span class="logo-art logo-text" aria-hidden="true">zenith</span>}
</a>
