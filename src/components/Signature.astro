---
// The signature is the traced artwork in src/assets/signature.svg. On the first load of a session it is
// revealed by pen strokes (src/data/signature-strokes.json, drawn in writing order inside a mask),
// then the mask is removed so the exact artwork shows. Reduced motion shows the finished artwork.
import strokes from "../data/signature-strokes.json"
const found = import.meta.glob("../assets/signature.svg", { query: "?raw", import: "default", eager: true })
const raw = Object.values(found)[0] as string | undefined
const viewBox = raw?.match(/viewBox="([^"]+)"/)?.[1]
const ink = raw?.match(/\sd="([^"]+)"/)?.[1]
---
<a class="logo" href="/" aria-label="Zenith Sharma, home">
  {ink && viewBox
    ? (
      <svg class="sig" viewBox={viewBox} role="img" aria-label="zenith" data-end={strokes.end}>
        <defs>
          <mask id="sig-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="900" height="367">
            {strokes.strokes.map((s) => (
              <path class="pen" d={s.d} pathLength="1" style={`--delay:${s.delay}s;--dur:${s.dur}s`} />
            ))}
          </mask>
        </defs>
        <path class="ink" fill-rule="evenodd" d={ink} />
      </svg>
    )
    : <span class="logo-text" aria-hidden="true">zenith</span>}
</a>
