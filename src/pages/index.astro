---
import Shell from "../layouts/Shell.astro"
import Entries from "../components/Entries.astro"
import { intro, work, built, tools, school } from "../lib/home"
---
<Shell section="home">
  {intro.length > 0 && (<>
    <h2 class="sec" id="intro"><span>Intro</span></h2>
    {intro.map((p) => <p class="lead">{p}</p>)}
  </>)}

  <Entries heading="Work" sid="work" id="work-before" entries={work} />

  {built.length > 0 && (<>
    <h2 class="sec" id="built"><span>Things I've built</span></h2>
    <div class="plist">
      {built.map((p) => {
        const Tag = p.href ? "a" : "div"
        return (
          <Tag class="proj" href={p.href} rel={p.href ? "noopener" : undefined}>
            <span class="name">{p.name}</span>
            {p.description && <span class="desc">{p.description}</span>}
            {p.href && <span class="arr">↗</span>}
          </Tag>
        )
      })}
    </div>
  </>)}

  {tools.length > 0 && (<>
    <h2 class="sec" id="tools"><span>Tools I reach for</span></h2>
    <dl>{tools.map((t) => <div class="kv"><dt>{t.label}</dt><dd>{t.items.join(" · ")}</dd></div>)}</dl>
  </>)}

  <Entries heading="School" sid="school" id="school-before" entries={school} />
</Shell>
