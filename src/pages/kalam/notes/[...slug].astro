---
import Frame from "../../../layouts/Frame.astro"
import { render } from "astro:content"
import { SITE, SPACE_NAME } from "../../../config"
import { allNotes, fmtDay, readingTime } from "../../../lib/content"

export async function getStaticPaths() {
  const list = await allNotes()
  return list.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: list[i - 1], older: list[i + 1] },
  }))
}
const { entry, newer, older } = Astro.props
const { Content } = await render(entry)
const { title, date, lang, excerpt } = entry.data
---
<Frame section="space" title={`${title} · ${SITE.name}`} description={excerpt}
  crumbs={[{ label: SPACE_NAME, href: "/kalam/" }, { label: "Notes", href: "/kalam/notes/" }]}>
  <article class="reader" lang={lang} dir={lang === "ur" ? "rtl" : undefined}>
    <a class="back" href="/kalam/notes/">← Notes</a>
    <h1>{title}</h1>
    <p class="rmeta">{fmtDay(date)} · {readingTime(entry.body)}</p>
    <div class="body-text"><Content /></div>
    <nav class="pager" aria-label="more notes">
      {older ? <a href={`/kalam/notes/${older.id}/`}>Older</a> : <span></span>}
      {newer ? <a href={`/kalam/notes/${newer.id}/`}>Newer</a> : <span></span>}
    </nav>
  </article>
</Frame>
