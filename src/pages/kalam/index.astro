---
import Frame from "../../layouts/Frame.astro"
import Tabs from "../../components/Tabs.astro"
import ShayariGrid from "../../components/ShayariGrid.astro"
import { SITE, SPACE_NAME } from "../../config"
import { allShayari, allNotes } from "../../lib/content"

const [shayari, notes] = await Promise.all([allShayari(), allNotes()])
---
<Frame section="space" title={`${SPACE_NAME} · ${SITE.name}`} crumbs={[{ label: SPACE_NAME, href: "/kalam/" }, { label: "Shayari", href: "/kalam/" }]}>
  <p class="lead" style="margin-top:0">Shayari, mostly written late. Notes on data, books, and whatever stayed with me.</p>
  <Tabs active="shayari" shayari={shayari.length} notes={notes.length} />
  <div id="list"><ShayariGrid items={shayari} /></div>
</Frame>
