---
import Base from "../../layouts/Base.astro"
import EntryList from "../../components/EntryList.astro"
import { getCollection } from "astro:content"

const poems = (await getCollection("poems", (e) => !e.data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---
<Base title="Poems" description="Shayari and poems.">
  <h1>Poems</h1>
  <p class="lede">Shayari and poems, in Urdu, Hindi and English.</p>
  <EntryList base="/poems/" empty="The first poems are on their way."
    items={poems.map((e) => ({ id: e.id, title: e.data.title, date: e.data.date, lang: e.data.lang, kind: e.data.kind }))} />
</Base>
