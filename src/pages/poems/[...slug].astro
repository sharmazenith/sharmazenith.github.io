---
import Base from "../../layouts/Base.astro"
import { getCollection, render } from "astro:content"

export async function getStaticPaths() {
  const poems = await getCollection("poems", (e) => !e.data.draft)
  return poems.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}
const { entry } = Astro.props
const { Content } = await render(entry)
const { title, date, lang, kind, translation, summary } = entry.data
const dir = lang === "ur" ? "rtl" : undefined
---
<Base title={title} description={summary ?? `A ${kind} by Zenith Sharma.`}>
  <article>
    <h1 lang={lang} dir={dir}>{title}</h1>
    <p class="meta">{kind} · {date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}</p>
    <div class="verse" lang={lang} dir={dir}><Content /></div>
    {translation && (
      <div class="translation"><h2 class="label">Translation</h2><p>{translation}</p></div>
    )}
  </article>
</Base>
