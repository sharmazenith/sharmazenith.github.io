---
import Base from "../../layouts/Base.astro"
import { getCollection, render } from "astro:content"

export async function getStaticPaths() {
  const notes = await getCollection("notes", (e) => !e.data.draft)
  return notes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}
const { entry } = Astro.props
const { Content } = await render(entry)
const { title, date, lang, summary } = entry.data
---
<Base title={title} description={summary}>
  <article>
    <h1>{title}</h1>
    <p class="meta">{date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}</p>
    <div class="prose" lang={lang} dir={lang === "ur" ? "rtl" : undefined}><Content /></div>
  </article>
</Base>
