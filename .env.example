# Publishing from the site runs in a Cloudflare Worker (worker/admin.js), not in the static site.
# These are that Worker's settings. Plain ones live in worker/wrangler.admin.toml [vars];
# secret ones are set with `npx wrangler secret put NAME -c worker/wrangler.admin.toml`.
# For local testing with `wrangler dev -c worker/wrangler.admin.toml`, put them in worker/.dev.vars (git ignored).

# SECRET. Fine grained personal access token: Repository access = only this repo, Permissions = Contents: Read and write.
# Never put it in client code.
GITHUB_TOKEN=

# Plain. owner/name of the repo GitHub Pages deploys from.
GITHUB_REPO=sharmazenith/sharmazenith.github.io

# Plain. The production branch. Publishing commits here, which triggers the Pages deploy.
GITHUB_BRANCH=main

# Plain. The only GitHub username allowed to sign in. Anyone else gets 403.
ADMIN_GITHUB_LOGIN=sharmazenith

# Plain. From the GitHub OAuth app.
GITHUB_OAUTH_CLIENT_ID=

# SECRET. From the GitHub OAuth app.
GITHUB_OAUTH_CLIENT_SECRET=

# SECRET. A long random string that signs session tokens. Generate: openssl rand -hex 32
SESSION_SECRET=

# Plain. The public site, for CORS and the post sign-in redirect.
SITE_ORIGIN=https://sharmazenith.github.io
